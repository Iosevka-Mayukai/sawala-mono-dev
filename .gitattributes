# Use LF line endings for text files; do not normalize to CRLF
* text=auto eol=lf

# Binary file types (prevent newline normalization from corrupting binary streams)
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.woff binary
*.woff2 binary
*.otf binary
*.eot binary
*.zip binary
*.tar.gz binary

# Recognize PatEL files for GitHub language stats
*.ptl linguist-language=PatEL
